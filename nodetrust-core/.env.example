# Copy to .env (never commit .env). Every value here is a placeholder.
# Operator token for instance-level actions (create projects, curate incidents).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NODETRUST_ADMIN_TOKEN=change-me
NODETRUST_DB_PATH=data/nodetrust.db

# Network is OFF by default. Set to true only on a server that should crawl npm / query OSV / send SMTP.
NODETRUST_ALLOW_NETWORK=false
NODETRUST_NPM_REGISTRY_URL=https://registry.npmjs.org
# Verify this endpoint against npm's current replication docs before enabling the feed (NT-006).
NODETRUST_NPM_CHANGES_URL=https://replicate.npmjs.com/registry/_changes
NODETRUST_OSV_API_URL=https://api.osv.dev/v1
NODETRUST_REQUIRED_SOURCES=feed:npm,intel:osv

# Offline demo / snapshot instance: label verdicts "offline snapshot, not live".
NODETRUST_SNAPSHOT_MODE=false

# Alerts: without SMTP settings, e-mails are written to the outbox directory.
NODETRUST_ALERT_OUTBOX_DIR=data/outbox
# NODETRUST_SMTP_HOST=
# NODETRUST_SMTP_PORT=587
# NODETRUST_SMTP_USER=
# NODETRUST_SMTP_PASSWORD=
# NODETRUST_SMTP_FROM=nodetrust@your-domain
# STARTTLS is required and the relay certificate is always verified. For a relay with a private CA:
# NODETRUST_SMTP_CA_FILE=/path/to/relay-ca.pem

# Limits on registry fetches that (untrusted) scan input can trigger.
NODETRUST_FETCH_BUDGET_PER_SCAN=200
NODETRUST_MAX_PENDING_SBOM_FETCHES=5000
NODETRUST_SBOM_FETCH_COOLDOWN_HOURS=24

# API surface: keep docs closed in production; failed-auth throttle per client IP.
NODETRUST_EXPOSE_API_DOCS=false
NODETRUST_AUTH_MAX_FAILURES=30
NODETRUST_AUTH_FAILURE_WINDOW_S=300
# Behind a reverse proxy, list the proxy IPs so the real client IP is used:
# NODETRUST_FORWARDED_ALLOW_IPS=127.0.0.1

NODETRUST_LOG_LEVEL=INFO
NODETRUST_RETENTION_DAYS=90
